{
  "name": "coursetrack",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:code": "next build",
    "build:vercel": "npm run check:deployment && npm run build:code",
    "start": "vinext start",
    "test": "npm run build && npm run test:contracts && npm run test:components",
    "test:contracts": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:components": "vitest run",
    "import:course-workbooks": "node --experimental-strip-types scripts/import-course-workbooks.mjs",
    "import:course-workbooks:apply": "node --experimental-strip-types scripts/import-course-workbooks.mjs --apply",
    "rollout:course-data-preflight": "node scripts/course-data-rollout-preflight.mjs",
    "check:deployment": "node scripts/check-deployment-readiness.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "smoke:deployment:health": "node scripts/smoke-deployment-health.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
