# CourseTrack requires Supabase; missing persistence is reported explicitly.
COURSETRACK_DATA_MODE=supabase
NEXT_PUBLIC_APP_NAME=CourseTrack
# Set to staging for the stable staging branch, production for main, and
# preview for feature deployments. Vercel system variables may also identify the environment.
COURSETRACK_ENVIRONMENT=development

# Server-only Supabase/Postgres adapter.
# Prefer the modern Supabase secret key. The legacy service-role key is accepted
# during key migration. Never expose either key to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase Auth configuration (see docs/auth-setup.md). These are
# intentionally public -- the anon/publishable key only grants what Row Level
# Security allows. Same project as SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Live LMS configuration is intentionally blank until provider documentation is
# confirmed. Keep credentials server-side.
LMS_PROVIDER_NAME=
LMS_BASE_URL=
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=

# Live, read-only Wrike course-version linking (see docs/wrike-setup.md).
# Server-only. Never exposed to the browser. Uses a Wrike permanent access
# token, not full OAuth -- generate one from the Wrike App Console for a
# dedicated CourseTrack app registration.
WRIKE_API_HOST=https://www.wrike.com
WRIKE_PERMANENT_TOKEN=
# 32+ random bytes, base64 or hex. Encrypts the stored Wrike token at rest.
TOKEN_ENCRYPTION_KEY=
# Shared secret an external scheduler (Vercel Cron / Cloudflare Cron Trigger)
# sends as "Authorization: Bearer <secret>" to POST /api/wrike/sync.
WRIKE_SYNC_CRON_SECRET=
# Optional Wrike custom-field id containing a linked version's published date.
WRIKE_VERSION_PUBLISHED_DATE_FIELD_ID=
