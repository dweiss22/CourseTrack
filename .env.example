# CourseTrack falls back to deterministic sample data when Supabase is absent.
COURSETRACK_DATA_MODE=supabase
NEXT_PUBLIC_APP_NAME=CourseTrack

# Server-only Supabase/Postgres adapter.
# Prefer the modern Supabase secret key. The legacy service-role key remains a
# supported fallback during migration. Never expose either key to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live LMS configuration is intentionally blank until provider documentation is
# confirmed. Keep credentials server-side.
LMS_PROVIDER_NAME=
LMS_BASE_URL=
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=

# Wrike task discovery stays on deterministic mock data until the production
# data link and documented API contract are supplied. No live URL or credential
# names are assumed here.
WRIKE_PROVIDER=mock
