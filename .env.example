# CourseTrack requires Supabase; missing persistence is reported explicitly.
COURSETRACK_DATA_MODE=supabase
NEXT_PUBLIC_APP_NAME=CourseTrack
# Set to staging for the stable staging branch, production for main, and
# preview for feature deployments. Vercel system variables may also identify the environment.
COURSETRACK_ENVIRONMENT=development
# Required by the deployment contract. Project references are identifiers,
# not keys; keep the two values distinct and scope them to the correct target.
COURSETRACK_PRODUCTION_SUPABASE_REF=
COURSETRACK_STAGING_SUPABASE_REF=
# Feature previews must use a third, isolated project when they publish.
COURSETRACK_PREVIEW_SUPABASE_REF=

# Server-only Supabase/Postgres adapter.
# Prefer the modern Supabase secret key. The legacy service-role key is accepted
# during key migration. Never expose either key to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase Auth configuration (see docs/auth-setup.md). These are
# intentionally public -- the anon/publishable key only grants what Row Level
# Security allows. Same project as SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Read-only Postgres login with only CONNECT, schema USAGE, and SELECT on
# supabase_migrations.schema_migrations. Never use an admin/database-owner URL.
COURSETRACK_SCHEMA_DATABASE_URL=
# Migration-capable Postgres URL. Scope it only to the matching protected
# GitHub environment. Import and release scripts require an explicit target
# and verify this URL's project ref before use.
COURSETRACK_MIGRATION_DATABASE_URL=

# Workflow-only release credentials/identifiers. Keep tokens in protected
# GitHub environment secrets, not in developer env files.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TEAM_SLUG=
SUPABASE_ACCESS_TOKEN=
COURSETRACK_PROMOTION_APP_ID=
COURSETRACK_PROMOTION_APP_PRIVATE_KEY=
AUTO_PROMOTE_STAGING_TO_MAIN=false
AUTO_PROMOTE_EXPIRES_AT=
COURSETRACK_CONTROLLED_RELEASES=false

# The authenticated smoke cookie is supplied ephemerally for a release check;
# do not save it in an env file, Vercel, GitHub, or another credential store.
COURSETRACK_SMOKE_BASE_URL=
COURSETRACK_SMOKE_SESSION_COOKIE=
COURSETRACK_SMOKE_COURSE_ID=
# Standard Vercel Deployment Protection bypass for CI smoke requests. This
# bypasses only Vercel protection; CourseTrack authentication still applies.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Live LMS configuration is intentionally blank until provider documentation is
# confirmed. Keep credentials server-side.
LMS_PROVIDER_NAME=
LMS_BASE_URL=
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=

# Live, read-only Wrike course-version linking (see docs/wrike-setup.md).
# Server-only. Never exposed to the browser. Uses a Wrike permanent access
# token, not full OAuth -- generate one from the Wrike App Console for a
# dedicated CourseTrack app registration.
WRIKE_API_HOST=https://www.wrike.com
WRIKE_PERMANENT_TOKEN=
# 32+ random bytes, base64 or hex. Encrypts the stored Wrike token at rest.
TOKEN_ENCRYPTION_KEY=
# Shared secret an external scheduler (Vercel Cron / Cloudflare Cron Trigger)
# sends as "Authorization: Bearer <secret>" to POST /api/wrike/sync.
WRIKE_SYNC_CRON_SECRET=
# Optional Wrike custom-field id containing a linked version's published date.
WRIKE_VERSION_PUBLISHED_DATE_FIELD_ID=
# Optional Wrike custom-field id containing a task's Reporting Year. Leave blank
# to match the field titled "Reporting Year" from the Wrike custom-field
# catalogue instead. Setting it lets the year resolve without a Wrike request.
WRIKE_REPORTING_YEAR_FIELD_ID=
