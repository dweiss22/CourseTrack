# CourseTrack defaults to deterministic sample mode.
COURSETRACK_DATA_MODE=sample
NEXT_PUBLIC_APP_NAME=CourseTrack

# Canonical production database (optional until Supabase is connected).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live LMS configuration is intentionally blank until provider documentation is
# confirmed. Keep credentials server-side.
LMS_PROVIDER_NAME=
LMS_BASE_URL=
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=
