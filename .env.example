# CourseTrack falls back to deterministic sample data when Supabase is absent.
COURSETRACK_DATA_MODE=supabase
NEXT_PUBLIC_APP_NAME=CourseTrack

# Server-only Supabase/Postgres adapter.
# Prefer the modern Supabase secret key. The legacy service-role key remains a
# supported fallback during migration. Never expose either key to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live LMS configuration is intentionally blank until provider documentation is
# confirmed. Keep credentials server-side.
LMS_PROVIDER_NAME=
LMS_BASE_URL=
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=

# Wrike task discovery (existing "Wrike work reference" browse panel on
# /versions) stays on deterministic mock data until the production data link
# and documented API contract are supplied.
WRIKE_PROVIDER=mock

# Live, read-only Wrike course-version linking (see docs/wrike-setup.md).
# Server-only. Never exposed to the browser. Uses a Wrike permanent access
# token, not full OAuth -- generate one from the Wrike App Console for a
# dedicated CourseTrack app registration.
WRIKE_API_HOST=https://www.wrike.com
WRIKE_PERMANENT_TOKEN=
# 32+ random bytes, base64 or hex. Encrypts the stored Wrike token at rest.
TOKEN_ENCRYPTION_KEY=
# Shared secret an external scheduler (Vercel Cron / Cloudflare Cron Trigger)
# sends as "Authorization: Bearer <secret>" to POST /api/wrike/sync.
WRIKE_SYNC_CRON_SECRET=
